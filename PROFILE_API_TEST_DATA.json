  "curl_commands": {
    "create_profile": {
      "description": "Créer un profil via cURL",
      "command": "curl -X POST http://localhost:8000/api/profiles \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"sexe\": \"M\",\n    \"nationalite\": \"Français\",\n    \"telephone\": \"+33612345678\",\n    \"niveau_etude_actuel\": \"Licence 3\",\n    \"domaine_etude\": \"Informatique\",\n    \"moyenne_generale\": \"14.5\"\n  }'"
    },
    "get_my_profile": {
      "description": "Récupérer son propre profil",
      "command": "curl -X GET http://localhost:8000/api/profiles \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\""
    },
    "update_profile": {
      "description": "Mettre à jour un profil",
      "command": "curl -X PATCH http://localhost:8000/api/profiles/1 \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"moyenne_generale\": \"15.5\",\n    \"niveau_francais\": \"Excellent\"\n  }'"
    },
    "delete_profile": {
      "description": "Supprimer un profil",
      "command": "curl -X DELETE http://localhost:8000/api/profiles/1 \\\n  -H \"Authorization: Bearer YOUR_JWT_TOKEN\""
    },
    "send_to_webhook": {
      "description": "Tester l'envoi au webhook N8N directement",
      "command": "curl -X POST https://iandrianinameeting.app.n8n.cloud/webhook-test/post \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"action\": \"profile_updated\",\n    \"timestamp\": \"2025-12-18T20:15:30Z\",\n    \"user\": {\n      \"id\": 1,\n      \"email\": \"test@example.com\",\n      \"nom\": \"Dupont\",\n      \"prenom\": \"Jean\"\n    },\n    \"profile\": {\n      \"id\": 1,\n      \"sexe\": \"M\",\n      \"nationalite\": \"Français\",\n      \"telephone\": \"+33612345678\",\n      \"niveau_etude_actuel\": \"Licence 3\",\n      \"domaine_etude\": \"Informatique\",\n      \"moyenne_generale\": \"14.5\"\n    }\n  }'"
    }
  }
